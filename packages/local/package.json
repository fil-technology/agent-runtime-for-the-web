{
  "name": "@agent-runtime/local",
  "version": "0.3.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "!dist/**/*.tsbuildinfo"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@agent-runtime/core": "workspace:*"
  },
  "peerDependencies": {
    "@huggingface/transformers": ">=3.0.0",
    "zod": "^3.23.8 || ^4.0.0"
  },
  "peerDependenciesMeta": {
    "@huggingface/transformers": {
      "optional": true
    }
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "zod": "^3.23.8"
  },
  "description": "On-device model providers: the browser's built-in model and SmolLM2 via transformers.js.",
  "license": "MIT",
  "keywords": [
    "ai",
    "agent",
    "llm",
    "assistant",
    "runtime",
    "chat",
    "tool-use"
  ],
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fil-technology/agent-runtime-for-the-web.git",
    "directory": "packages/local"
  },
  "publishConfig": {
    "access": "public"
  },
  "homepage": "https://github.com/fil-technology/agent-runtime-for-the-web#readme",
  "bugs": {
    "url": "https://github.com/fil-technology/agent-runtime-for-the-web/issues"
  }
}
